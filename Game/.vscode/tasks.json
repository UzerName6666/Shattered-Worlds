{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/std:c++17",
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\DEMO_Labyrint.exe",
                "${workspaceFolder}\\*.cpp",
                "/link", 
                "/subsystem:windows"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Default Build"
        }
    ],
    "version": "2.0.0"
}